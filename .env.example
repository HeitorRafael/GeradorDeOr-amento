# ────────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente — copie este arquivo para .env e preencha os valores
# ────────────────────────────────────────────────────────────────────────────────

# Banco de dados (PostgreSQL)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/budget_generator"

# JWT — chave secreta para assinar os tokens (use uma string longa e aleatória)
JWT_SECRET="sua-chave-secreta-aqui"

# Google Gemini API Key
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="sua-gemini-api-key-aqui"

# URL do frontend (usado pelo backend para configurar o CORS)
# Em produção: URL do seu projeto Angular na Vercel (ex: https://gerador-orcamento.vercel.app)
FRONTEND_URL="http://localhost:4200"

# Porta local do servidor (opcional — padrão: 3000)
PORT=3000
